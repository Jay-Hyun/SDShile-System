{
 "source": "Bugs synced lyrics for 소리엘 '옷자락에서 전해지는 사랑' (track 80045568), checked against MR beat grid (66 BPM, lines every 8 beats, within ±0.4 s)",
 "timebase": "MR seconds of the tempo-105% MR (all times = original Bugs times / 1.05; add the prelude length for film time)",
 "lead_seconds": 0.35,
 "lines": [
  {
   "id": "l01",
   "text": "오래전 부터 날 누르는",
   "start": 27.17,
   "end": 33.5,
   "sung": 27.52
  },
  {
   "id": "l02",
   "text": "내 안의 깊은 절망",
   "start": 33.65,
   "end": 40.17,
   "sung": 34.0
  },
  {
   "id": "l03",
   "text": "아무 희망도 어떤 기대도",
   "start": 40.32,
   "end": 47.31,
   "sung": 40.67
  },
  {
   "id": "l04",
   "text": "내겐 없는데",
   "start": 47.46,
   "end": 54.07,
   "sung": 47.81
  },
  {
   "id": "l05",
   "text": "사람들의 외면과 날 거절하는 눈빛",
   "start": 54.22,
   "end": 67.88,
   "sung": 54.57
  },
  {
   "id": "l06",
   "text": "아픈 상처로 짙은 어둠으로",
   "start": 68.03,
   "end": 74.55,
   "sung": 68.38
  },
  {
   "id": "l07",
   "text": "깊이 빠져만 가는데",
   "start": 74.7,
   "end": 81.31,
   "sung": 75.05
  },
  {
   "id": "l08",
   "text": "어디선가 내게 들리는",
   "start": 81.46,
   "end": 87.88,
   "sung": 81.81
  },
  {
   "id": "l09",
   "text": "하나님 아들 주님 이야기",
   "start": 88.03,
   "end": 94.64,
   "sung": 88.38
  },
  {
   "id": "l10",
   "text": "그 분이라면 그의 옷자락이라도",
   "start": 94.79,
   "end": 102.17,
   "sung": 95.14
  },
  {
   "id": "l11",
   "text": "내 마지막 소망이니",
   "start": 102.32,
   "end": 110.26,
   "sung": 102.67
  },
  {
   "id": "l12",
   "text": "주님을 만났네",
   "start": 110.41,
   "end": 117.21,
   "sung": 110.76
  },
  {
   "id": "l13",
   "text": "옷자락에서 전해지는 사랑",
   "start": 117.36,
   "end": 124.26,
   "sung": 117.71
  },
  {
   "id": "l14",
   "text": "내게 임한 주님의 능력",
   "start": 124.41,
   "end": 130.55,
   "sung": 124.76
  },
  {
   "id": "l15",
   "text": "날 누르는 아픔의 근원을 고치셨네",
   "start": 130.7,
   "end": 137.5,
   "sung": 131.05
  },
  {
   "id": "l16",
   "text": "날 바라보시네",
   "start": 137.65,
   "end": 144.17,
   "sung": 138.0
  },
  {
   "id": "l17",
   "text": "나의 연약함 주님은 아시네",
   "start": 144.32,
   "end": 151.12,
   "sung": 144.67
  },
  {
   "id": "l18",
   "text": "깊은 절망에서",
   "start": 151.27,
   "end": 154.45,
   "sung": 151.62
  },
  {
   "id": "l19",
   "text": "날 자유케 하신 사랑",
