{
 "source": "Bugs synced lyrics for 소리엘 '옷자락에서 전해지는 사랑' (track 80045568), checked against MR beat grid (66 BPM, lines every 8 beats, within ±0.4 s)",
 "timebase": "MR seconds (add the prelude length for film time)",
 "lead_seconds": 0.35,
 "lines": [
  {
   "id": "l01",
   "text": "오래전 부터 날 누르는",
   "start": 28.55,
   "end": 35.2,
   "sung": 28.9
  },
  {
   "id": "l02",
   "text": "내 안의 깊은 절망",
   "start": 35.35,
   "end": 42.2,
   "sung": 35.7
  },
  {
   "id": "l03",
   "text": "아무 희망도 어떤 기대도",
   "start": 42.35,
   "end": 49.7,
   "sung": 42.7
  },
  {
   "id": "l04",
   "text": "내겐 없는데",
   "start": 49.85,
   "end": 56.8,
   "sung": 50.2
  },
  {
   "id": "l05",
   "text": "사람들의 외면과 날 거절하는 눈빛",
   "start": 56.95,
   "end": 71.3,
   "sung": 57.3
  },
  {
   "id": "l06",
   "text": "아픈 상처로 짙은 어둠으로",
   "start": 71.45,
   "end": 78.3,
   "sung": 71.8
  },
  {
   "id": "l07",
   "text": "깊이 빠져만 가는데",
   "start": 78.45,
   "end": 85.4,
   "sung": 78.8
  },
  {
   "id": "l08",
   "text": "어디선가 내게 들리는",
   "start": 85.55,
   "end": 92.3,
   "sung": 85.9
  },
  {
   "id": "l09",
   "text": "하나님 아들 주님 이야기",
   "start": 92.45,
   "end": 99.4,
   "sung": 92.8
  },
  {
   "id": "l10",
   "text": "그 분이라면 그의 옷자락이라도",
   "start": 99.55,
   "end": 107.3,
   "sung": 99.9
  },
  {
   "id": "l11",
   "text": "내 마지막 소망이니",
   "start": 107.45,
   "end": 115.8,
   "sung": 107.8
  },
  {
   "id": "l12",
   "text": "주님을 만났네",
   "start": 115.95,
   "end": 123.1,
   "sung": 116.3
  },
  {
   "id": "l13",
   "text": "옷자락에서 전해지는 사랑",
   "start": 123.25,
   "end": 130.5,
   "sung": 123.6
  },
  {
   "id": "l14",
   "text": "내게 임한 주님의 능력",
   "start": 130.65,
   "end": 137.1,
   "sung": 131.0
  },
  {
   "id": "l15",
   "text": "날 누르는 아픔의 근원을 고치셨네",
   "start": 137.25,
   "end": 144.4,
   "sung": 137.6
  },
  {
   "id": "l16",
   "text": "날 바라보시네",
   "start": 144.55,
   "end": 151.4,
   "sung": 144.9
  },
  {
   "id": "l17",
   "text": "나의 연약함 주님은 아시네",
   "start": 151.55,
   "end": 158.7,
   "sung": 151.9
  },
  {
   "id": "l18",
   "text": "깊은 절망에서",
   "start": 158.85,
   "end": 162.2,
   "sung": 159.2
  },
  {
   "id": "l19",
   "text": "날 자유케 하신 사랑",
   "start": 162.35,
   "end": 167.8,
   "sung": 162.7
  },
  {
   "id": "l20",
   "text": "나 찬양해",
