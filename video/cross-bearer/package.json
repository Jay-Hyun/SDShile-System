{
  "name": "cross-bearer-opening",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "still": "node src/render.mjs still",
    "render": "node src/render.mjs video",
    "music": "python3 src/music.py && src/master.sh",
    "all": "npm run build && npm run music && npm run render",
    "mux": "ffmpeg -y -loglevel error -i out/video-silent.mp4 -i out/music.wav -c:v copy -c:a aac -b:a 256k -ar 48000 -shortest -movflags +faststart out/final.mp4"
  },
  "dependencies": {
    "@audio-samples/piano-velocity13": "^1.0.5",
    "@audio-samples/piano-velocity3": "^1.0.5",
    "@audio-samples/piano-velocity8": "^1.0.5",
    "canvaskit-wasm": "0.41.1",
    "tonejs-instrument-cello-mp3": "^1.1.1",
    "tonejs-instrument-piano-mp3": "^1.1.2"
  }
}
